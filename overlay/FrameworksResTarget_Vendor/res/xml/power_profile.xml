      <value>1651200</value>  <!-- 1651.2  MHz CPU speed -->
      <value>1804800</value>  <!-- 1804.8  MHz CPU speed -->
  </array>

  <!-- Current at each CPU speed for cluster 0, as per 'cpu.speeds.cluster0'.
