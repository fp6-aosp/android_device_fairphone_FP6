cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.FP6",
    relative_install_path: "hw",
    init_rc: ["android.hardware.biometrics.fingerprint-service.FP6.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.FP6.xml"],
    srcs: [
        "CancellationSignal.cpp",
        "Fingerprint.cpp",
        "FingerprintConfig.cpp",
        "LockoutTracker.cpp",
        "Session.cpp",
        "focaltech/FocalConfig.cpp",
        "focaltech/FocalDevice.cpp",
        "focaltech/FocalHal.cpp",
        "focaltech/FocalTrustlet.cpp",
        "service.cpp",
    ],
    local_include_dirs: [
        "include",
    ],
    header_libs: [
        "libhardware_headers",
    ],
    shared_libs: [
        "libQSEEComAPI",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libjsoncpp",
        "liblog",
        "android.hardware.biometrics.fingerprint-V4-ndk",
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.common.config",
        "android.hardware.biometrics.common.thread",
        "android.hardware.biometrics.common.util",
    ],
    static_libs: [
        "libandroid.hardware.biometrics.fingerprint.fairphone.Props",
    ],
    required: ["ff_config.json"],
    vendor: true,
}

prebuilt_etc {
    name: "ff_config.json",
    src: "config/ff_config.json",
    sub_dir: "focaltech",
    vendor: true,
}

sysprop_library {
    name: "android.hardware.biometrics.fingerprint.fairphone.Props",
    srcs: ["fingerprint.sysprop"],
    property_owner: "Vendor",
    vendor: true,
}
