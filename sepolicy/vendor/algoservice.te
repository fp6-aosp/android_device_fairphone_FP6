add_service(hal_camera_default, vendor_tct_camera_algo_service)
init_daemon_domain(hal_camera_default)
binder_use(hal_camera_default)

allow hal_camera_default hwservicemanager_prop:file {read open getattr map};
allow hal_camera_default priv_app:binder { call transfer };
allow hal_camera_default platform_app:binder { call transfer };
allow hal_camera_default fwk_camera_hwservice:hwservice_manager find;
allow hal_camera_default fwk_sensor_hwservice:hwservice_manager find;
allow hal_camera_default cameraserver_service:service_manager find;
allow hal_camera_default fwk_camera_service:service_manager find;
#allow hal_camera_default hal_graphics_mapper_hwservice:hwservice_manager find;
hal_client_domain(hal_camera_default, hal_graphics_allocator)

allow hal_camera_default gpu_device:dir search;
allow hal_camera_default gpu_device:chr_file rw_file_perms;
allow hal_camera_default ion_device:chr_file r_file_perms;
allow hal_camera_default dmabuf_system_heap_device:chr_file r_file_perms;

allow hal_camera_default vendor_camera_dump_file:dir create_dir_perms;
allow hal_camera_default vendor_camera_dump_file:file create_file_perms;

allow hal_camera_default vendor_camera_data_file:dir create_dir_perms;
allow hal_camera_default vendor_camera_data_file:file create_file_perms;
allow hal_camera_default vendor_camera_data_file:dir search;

#allow hal_camera_default proc_ged:file r_file_perms;
#allowxperm hal_camera_default proc_ged:file ioctl { proc_ged_ioctls };
#allow hal_camera_default debugfs_ion:dir search;

get_prop(hal_camera_default, vendor_default_prop)
get_prop(hal_camera_default, camera_config_prop)
get_prop(hal_camera_default, vendor_camera_prop)
get_prop(hal_camera_default, vendor_fp_prop)
set_prop(hal_camera_default, vendor_camera_prop)

binder_call(hal_camera_default, system_server)
binder_call(hal_camera_default, cameraserver)

# SOCAOSP13-7770, -m CtsSecurityHostTestCases -t android.security.cts.SELinuxHostTest#testNoBugreportDenials
allow dumpstate hal_camera_default:binder call;

# camerapostproc service
hal_client_domain(hal_camera_default, hal_camera);

# ADSP access
allow hal_camera_default vendor_xdsp_device:chr_file { r_file_perms };
r_dir_file(hal_camera_default, adsprpcd_file);
get_prop(hal_camera_default, vendor_adsprpc_prop)
allow hal_camera_default vendor_hal_dspmanager_hwservice:hwservice_manager find;
hal_client_domain(hal_camera_default, vendor_hal_dspmanager)
allow hal_camera_default vendor_hal_qspmhal_service:service_manager find;
hal_client_domain(hal_camera_default, vendor_hal_qspmhal)
